{
  "name": "yt-bookmark-pins",
  "version": "1.1",
  "description": "YouTube Bookmark Pins Chrome extension build & release scripts",
  "main": "content.js",
  "scripts": {
    "bump": "npm version minor --no-git-tag-version",
    "sync-manifest": "json -I -f manifest.json -e \"this.version=require('./package.json').version\"",
    "build": "terser content.js --compress --mangle --output content.min.js",
    "zip": "zip -r yt-bookmark-pins-$(node -p \"require('./package.json').version\").zip . -x node_modules/**\\*",
    "release": "npm run bump && npm run sync-manifest && npm run build && npm run zip"
  },
  "devDependencies": {
    "json": "^11.0.0",
    "terser": "^5.39.0"
  },
  "keywords": [
    "youtube",
    "bookmark",
    "pins",
    "extension"
  ],
  "author": "Tan Thai",
  "license": "SEE LICENSE IN LICENSE.txt"
}
