{
  "manifest_version": 3,
  "name": "YTBookmarks",
  "version": "2.0",
  "description": "Enhanced YouTube bookmarking with visual pins on the progress bar, customizable settings, and a draggable sidebar. Features auto-pause, labels, undo support, and bookmark import/export.",
  "permissions": ["storage", "scripting", "webNavigation"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["styles.css"],
    "matches": ["*://*.youtube.com/*"]
  }],
  "icons": {
    "48": "icon48.png"
  },
  "action": {
    "default_title": "YTBookmarks"
  }
}
