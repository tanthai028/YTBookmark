{
   "action": {
      "default_popup": "popup.html",
      "default_icon": { "48": "icon48.png" }
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [ "*://www.youtube.com/*", "*://*.youtube.com/*", "*://youtu.be/*" ],
      "run_at": "document_start"
   } ],
   "description": "Add visual pins to YouTube's progress bar to bookmark key moments. Features instant labeling, undo support, and bookmark sharing.",
   "icons": {
      "48": "icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "YTBookmarks",
   "permissions": [ "contextMenus" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.3",
   "web_accessible_resources": [ {
      "matches": [ "*://*.youtube.com/*" ],
      "resources": [ "styles.css", "icon48.png" ]
   } ]
}
