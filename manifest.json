{
  "manifest_version": 3,
  "name": "YTBookmarks",
  "version": "2.2",
  "description": "Add visual pins to YouTube's progress bar to bookmark key moments. Features instant labeling, undo support, and bookmark sharing.",
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["styles.css", "icon48.png"],
    "matches": ["*://*.youtube.com/*"]
  }],
  "icons": {
    "48": "icon48.png"
  }
}
