{
  "manifest_version": 2,
  "name": "YTBookmarks",
  "version": "2.0",
  "description": "Add visual bookmarks to YouTube videos with customizable pins, labels, and settings. Features auto-pause, undo, and bookmark sharing.",
  "permissions": ["storage", "scripting", "webNavigation"],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://*.youtube.com/*",
    "*://youtu.be/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [{
    "resources": ["styles.css", "icon48.png"],
    "matches": ["*://*.youtube.com/*"]
  }],
  "icons": {
    "48": "icon48.png"
  },
  "action": {
    "default_title": "YTBookmarks"
  }
}
